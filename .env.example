# Copy to .env and fill in before deploying. Never commit .env.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=app.mojoandco.uk
DJANGO_SECURE_HTTPS=True
CSRF_TRUSTED_ORIGINS=https://app.mojoandco.uk

# Where the container binds on the host. The default keeps it behind Caddy.
# 0.0.0.0 exposes it directly over plain HTTP — only for testing before TLS.
BIND_ADDRESS=172.17.0.1
HOST_PORT=8010

POSTGRES_DB=mojo
POSTGRES_USER=mojo
POSTGRES_PASSWORD=

# Optional: creates Jess's admin account on first boot.
# This is also the answer to "what's my username?" — nothing in the repo knows
# it, only whatever was set here. `manage.py accounts` lists what exists.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=info@mojoandco.uk

# Where reset and intake links point when nothing built them from a live
# request — the management commands, and any email sent from a shell.
PUBLIC_BASE_URL=https://app.mojoandco.uk

# Optional SMTP. Leave EMAIL_HOST blank and nothing is sent: reset links are
# handed back to the app to forward by hand, which is how intake forms have
# always been delivered. Fill it in to have the app offer to email them.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Mojo and Co <info@mojoandco.uk>

# How far ahead a repeating booking fills the diary.
BOOKING_SERIES_HORIZON_WEEKS=26
# How long an emailed intake link stays valid.
INTAKE_INVITE_TTL_DAYS=30
# How long a password reset link stays valid.
PASSWORD_RESET_TTL_HOURS=24
