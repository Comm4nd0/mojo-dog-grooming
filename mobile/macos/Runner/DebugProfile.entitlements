<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Talking to the API, and google_fonts fetching its faces. A sandboxed
	     app with no network.client cannot open a single socket, and the
	     failure is a silent connection error, not a permissions prompt. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- image_picker on macOS is an open panel, and the powerbox only grants
	     what the user picked when this is declared. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- flutter_secure_storage keeps the API token in the Keychain. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)uk.co.mojoandco.mojoApp</string>
	</array>
</dict>
</plist>
